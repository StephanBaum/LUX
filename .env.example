# iCal Calendar Feed URLs
# Set these in your Vercel dashboard or local .env file

# Google Calendar / Apple Calendar URL for studio bookings
# This calendar blocks dates on the rental calendar
ICAL_RESERVATIONS_URL=

# Calendar URL for events (Veranstaltungen page)
ICAL_EVENTS_URL=

# Calendar URL for workshops (Workshops page)
ICAL_WORKSHOPS_URL=

# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Übersetzung (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# The mailbox the enquiry form sends from. Your own mail account at the hoster.
# Nothing is stored — the enquiry is sent and then gone.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=servus@luxenburger.de
SMTP_PASS=
# Optional. Defaults to SMTP_USER.
SMTP_FROM=
# Where the enquiries land. Defaults to SMTP_USER.
INQUIRY_TO=
