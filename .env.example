# iCal Calendar Feed URLs
# Set these in your Vercel dashboard or local .env file

# Google Calendar / Apple Calendar URL for studio bookings
# This calendar blocks dates on the rental calendar
ICAL_RESERVATIONS_URL=

# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Übersetzung (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# The mailbox the enquiry form sends from. Your own mail account at the hoster.
# Nothing is stored — the enquiry is sent and then gone.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=servus@luxenburger.de
SMTP_PASS=
# Optional. Defaults to SMTP_USER.
SMTP_FROM=
# Where the enquiries land. Defaults to SMTP_USER.
INQUIRY_TO=

# Google Calendar, two-way sync for workshops and events.
# One Google Cloud project with the Calendar API on, one service account.
# Share both calendars with the service account address, "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the service account's JSON key, with the line breaks written as \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_WORKSHOPS=
GOOGLE_CALENDAR_EVENTS=
# A long random string. Guards the two sync endpoints and the Sanity webhook.
SYNC_SECRET=
# Where Google should call back, e.g. https://lux-studio.lu
PUBLIC_SITE_URL=

# Reservierungen: Anfragen, die das Studio per E-Mail zusagt oder absagt.
# Der Kalender, den die Mieten-Seite schon liest. Er muss privat sein und mit
# dem Service-Account geteilt, "Termine ändern".
GOOGLE_CALENDAR_RESERVATIONS=
# Verschlüsselt die Zusage- und Absage-Links. openssl rand -hex 32
# Wird er gewechselt, lassen sich bereits verschickte Links nicht mehr öffnen.
RESERVATION_SECRET=
