---
// Menu Overlay component - reusable across all pages
import {getSiteContent} from '../lib/sanity/queries';
import Photo from './Photo.astro';
import {imageUrl} from '../lib/sanity/image';
import {getNavigation} from '../lib/content/navigation';

const {siteSettings} = await getSiteContent();
const navigation = await getNavigation();
const legal = siteSettings?.footerLabels ?? {};
const partners = siteSettings?.partnerLogos ?? [];

// The overlay shows one of these at random each time it opens.
const {homePage} = await getSiteContent();
const menuImages = [siteSettings?.menuImage, ...(homePage?.sliderImages ?? [])]
  .map((photo) => imageUrl(photo, 1600))
  .filter(Boolean);
---

<div class="menu-overlay">
  <!-- Background image that fades in -->
  <div class="menu-overlay__bg" data-images={JSON.stringify(menuImages)}>
    <Photo photo={siteSettings?.menuImage} width={1600} />
  </div>

  <!-- Panel that slides in from right -->
  <div class="menu-overlay__panel">
    <button class="menu-overlay__close" aria-label="Close menu">
      <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 2L26 26M26 2L2 26" stroke="currentColor" stroke-width="4"/>
      </svg>
    </button>

    <nav class="menu-overlay__nav">
      {navigation.map((entry) => (
        <a href={entry.href} class="menu-overlay__link">
          <span data-i18n={`nav.${entry.key}`}>{entry.label}</span>
          <svg class="menu-overlay__arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
          </svg>
        </a>
      ))}
    </nav>

    <div class="menu-overlay__contact">
      <p>
        {siteSettings?.studioName}<br />
        {siteSettings?.companyName}<br />
        {siteSettings?.street}<br />
        {[siteSettings?.postalCode, siteSettings?.city].filter(Boolean).join(' ')}
      </p>
      <p>
        {siteSettings?.phone && <>T {siteSettings.phone}<br /></>}
        {siteSettings?.fax && <>F {siteSettings.fax}<br /></>}
        {siteSettings?.mobile && <>M {siteSettings.mobile}</>}
      </p>
      {siteSettings?.email && (
        <p>E <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></p>
      )}
    </div>
    <div class="menu-overlay__footer">
      <div class="menu-overlay__partners">
        <span class="menu-overlay__partners-label" data-i18n="footer.partners_label">{siteSettings?.partnersLabel}</span>
        <span class="menu-overlay__partners-logos">{partners.map((partner) => partner.name).join(" ")}</span>
      </div>
      <div class="menu-overlay__bottom">
        <div class="menu-overlay__legal">
          <a href="/impressum" data-i18n="footer.impressum">{legal.impressum}</a>
          <a href="/datenschutz" data-i18n="footer.datenschutz">{legal.datenschutz}</a>
          <a href="/agb" data-i18n="footer.agb">{legal.agb}</a>
        </div>
        <div class="menu-overlay__lang">
          <a href="#" data-lang="de" class="menu-overlay__lang-link">DE</a>
          <a href="#" data-lang="en" class="menu-overlay__lang-link">EN</a>
          <a href="#" data-lang="fr" class="menu-overlay__lang-link">FR</a>
          <a href="#" data-lang="lu" class="menu-overlay__lang-link">LU</a>
        </div>
      </div>
    </div>
  </div>
</div>
