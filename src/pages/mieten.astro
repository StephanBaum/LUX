---
import Base from '../layouts/Base.astro';
import SEO from '../components/SEO.astro';
import '../styles/components/page-header.css';
import '../styles/components/accordion.css';
import '../styles/components/checkbox-group.css';
import '../styles/components/calendar.css';
import '../styles/components/form.css';
import {getGermanBundles} from '../lib/content/bundle';
import {createT} from '../lib/content/t';
import {getSiteContent} from '../lib/sanity/queries';
import Photo from '../components/Photo.astro';
import {imageUrl} from '../lib/sanity/image';

const t = createT(await getGermanBundles(), 'mieten');
const {siteSettings, mietenPage, rooms, equipment} = await getSiteContent();

const slugOf = (doc) => doc.slug?.current ?? String(doc._id).replace(/^[a-z]+-/, '');

const roomItems = (rooms ?? []).map((room) => ({
  ...room,
  key: slugOf(room),
  image: imageUrl(room.photo, 1400),
}));

const EQUIPMENT_CATEGORIES = ['light', 'camera', 'grip'];
const equipmentByCategory = EQUIPMENT_CATEGORIES.map((category) => ({
  category,
  items: (equipment ?? []).filter((item) => item.category === category),
})).filter((group) => group.items.length > 0);

const rentalSchema = [
  {
    '@type': 'Product',
    name: 'Großes Studio - Tagesmiete',
    description: '250m² Studioraum mit 6m Deckenhöhe, 8x6m Hohlkehle und Tageslicht. Ideal für große Foto- und Filmproduktionen.',
    image: imageUrl((rooms ?? [])[0]?.photo, 1200),
    url: 'https://luxenburger.de/mieten',
    brand: {
      '@type': 'Organization',
      name: siteSettings?.studioName
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: '450',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      url: 'https://luxenburger.de/mieten'
    }
  },
  {
    '@type': 'Product',
    name: 'Kleines Studio - Tagesmiete',
    description: '80m² Studioraum mit 4m Deckenhöhe und 4x4m Hohlkehle. Ideal für Portraits und Produktfotografie.',
    image: imageUrl((rooms ?? [])[1]?.photo, 1200),
    url: 'https://luxenburger.de/mieten',
    brand: {
      '@type': 'Organization',
      name: siteSettings?.studioName
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: '200',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      url: 'https://luxenburger.de/mieten'
    }
  },
  {
    '@type': 'Product',
    name: 'Analog Studio - Tagesmiete',
    description: '45m² Dunkelkammer mit Vergrößerer und Entwicklungsbecken. Für analoge Schwarz-Weiß- und Farbfotografie.',
    image: imageUrl((rooms ?? [])[2]?.photo, 1200),
    url: 'https://luxenburger.de/mieten',
    brand: {
      '@type': 'Organization',
      name: siteSettings?.studioName
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: '150',
      priceValidUntil: '2026-12-31',
      availability: 'https://schema.org/InStock',
      url: 'https://luxenburger.de/mieten'
    }
  }
];
---

<Base
  title="Studio Mieten - LUX Studio | Studioräume in Schwalbach"
  description="Professionelle Studioräume mieten bei Studio Luxenburger: Großes Studio, kleines Studio und Dunkelkammer. Equipment-Verleih inklusive."
  image={imageUrl(roomItems[0]?.photo, 1200, 630)}
>
  <SEO schema={rentalSchema} slot="head" />

  <!-- Page Header -->
  <section class="page-header page-header--subpage">
    <div class="page-header__container grid">
      <h1 class="page-header__title" data-animate="fade-up" data-i18n="header.title">{t('header.title')}</h1>
      <div class="page-header__content page-header__content--wide">
        <p class="page-header__text" data-animate="fade-up" data-i18n="header.text">{t('header.text')}</p>
        <div class="partners partners--inline" style="margin-top: var(--space-lg);" data-animate="fade-up">
          <span class="partners__logo">HASSELBLAD</span>
          <span class="partners__logo">ARRI</span>
          <span class="partners__logo">RED</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Räume Section -->
  <section class="mieten-section mieten-section--rooms">
    <div class="grid">
      <h2 class="mieten-section__title" data-animate="fade-up" data-i18n="sections.rooms">{t('sections.rooms')}</h2>
      <!-- Image container - LEFT side -->
      <div class="subpage-section__image subpage-section__image--left is-visible" data-accordion-image-target>
        <Photo photo={roomItems[0]?.photo} width={1400} />
      </div>
      <div class="mieten-section__accordion" data-animate="fade-up">
        <div class="accordion" data-accordion data-accordion-images>
          <!-- Großes Studio -->
          {roomItems.map((room, i) => (
            <div class={`accordion__item${i === 0 ? ' is-open' : ''}`} data-accordion-item data-image={room.image}>
              <button class="accordion__header" data-accordion-trigger>
                <label class="accordion__checkbox">
                  <input type="checkbox" name="room" value={room.key} />
                  <span class="accordion__check"></span>
                </label>
                <span class="accordion__title" data-i18n={`rooms.${room.key}.title`}>{room.title}</span>
                <svg class="accordion__arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
                </svg>
              </button>
              <div class="accordion__content" data-accordion-content>
                <div class="accordion__inner">
                  <div class="accordion__text">
                    <div class="accordion__profile-intro">
                      <h3 class="accordion__profile-title" data-i18n={`rooms.${room.key}.size`}>{room.size}</h3>
                    </div>
                    <div class="accordion__profile-section">
                      <h4 class="accordion__profile-section-title" data-i18n="rooms.equipment_label">{t('rooms.equipment_label')}</h4>
                      {(room.features ?? []).map((feature, n) => (
                        <div class="accordion__profile-item">
                          <span class="accordion__profile-item-title" data-i18n={`rooms.${room.key}.features.${n}`}>{feature}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="accordion__description">
                    <p data-i18n={`rooms.${room.key}.desc`}>{room.description}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment Section -->
  <section class="mieten-section" data-parallax="0.05">
    <div class="grid">
      <h2 class="mieten-section__title" data-animate="fade-up" data-i18n="sections.equipment">{t('sections.equipment')}</h2>
      <div class="mieten-section__content">
        <div class="checkbox-group checkbox-group--multi" data-animate="fade-up">
          {equipmentByCategory.map((group) => (
            <div class="checkbox-group__category">
              <h4 class="checkbox-group__category-title" data-i18n={`equipment.${group.category}`}>{t(`equipment.${group.category}`)}</h4>
              <div class="checkbox-group__items">
                {group.items.map((item) => (
                  <div class="checkbox-group__item checkbox-group__item--compact">
                    <label class="checkbox-group__label">
                      <input type="checkbox" class="checkbox-group__checkbox" name="equipment" value={slugOf(item)} />
                      <span class="checkbox-group__check"></span>
                      <span class="checkbox-group__text">{item.name}</span>
                    </label>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Zeitraum & Anfrage Section -->
  <section class="mieten-section mieten-section--form" data-parallax="0.05">
    <div class="grid">
      <h2 class="mieten-section__title" data-animate="fade-up" data-i18n="sections.period">{t('sections.period')}</h2>
      <div class="mieten-section__content">
        <div class="calendar" data-calendar data-animate="fade-up">
          <div class="calendar__header">
            <span class="calendar__display" data-calendar-display></span>
            <div class="calendar__nav">
              <button type="button" class="calendar__nav-btn" data-calendar-prev aria-label="Vorheriger Monat">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15 19L8 12L15 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button type="button" class="calendar__nav-btn" data-calendar-next aria-label="Nächster Monat">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="calendar__months">
            <div class="calendar__month-col">
              <div class="calendar__weekdays">
                <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
              </div>
              <div class="calendar__grid" data-calendar-grid="0"></div>
            </div>
            <div class="calendar__month-col">
              <div class="calendar__weekdays">
                <span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
              </div>
              <div class="calendar__grid" data-calendar-grid="1"></div>
            </div>
          </div>
          <div class="calendar__hint" data-i18n="calendar.hint">{t('calendar.hint')}</div>
          <input type="hidden" name="date_start" data-calendar-start>
          <input type="hidden" name="date_end" data-calendar-end>
        </div>
      </div>
    </div>
  </section>

  <!-- Anfrage Form -->
  <section class="mieten-section mieten-section--form" data-parallax="0.05">
    <div class="grid">
      <h2 class="mieten-section__title" data-animate="fade-up" data-i18n="sections.inquiry">{t('sections.inquiry')}</h2>
      <div class="mieten-section__content">
        <form class="form" data-form novalidate data-animate="fade-up">
          <div class="form__row form__row--two-col">
            <div class="form__field">
              <input type="text" class="form__input" name="name" placeholder={t('form.name_placeholder')} required data-validate data-i18n-placeholder="form.name_placeholder">
              <span class="form__error" data-i18n="form.error_name">{t('form.error_name')}</span>
            </div>
            <div class="form__field">
              <input type="text" class="form__input" name="firma" placeholder={t('form.company_placeholder')} data-i18n-placeholder="form.company_placeholder">
            </div>
          </div>

          <div class="form__row form__row--two-col">
            <div class="form__field">
              <input type="email" class="form__input" name="email" placeholder={t('form.email_placeholder')} required data-validate data-i18n-placeholder="form.email_placeholder">
              <span class="form__error" data-i18n="form.error_email">{t('form.error_email')}</span>
            </div>
            <div class="form__field">
              <input type="tel" class="form__input" name="telefon" placeholder={t('form.phone_placeholder')} data-i18n-placeholder="form.phone_placeholder">
            </div>
          </div>

          <div class="form__row">
            <div class="form__field form__field--summary">
              <span class="form__summary-value"><strong data-i18n="form.selection_label">{t('form.selection_label')}</strong> <span data-form-date data-i18n="calendar.hint">{t('calendar.hint')}</span>, <span data-form-selection data-i18n="form.no_selection">{t('form.no_selection')}</span></span>
            </div>
          </div>

          <div class="form__row">
            <div class="form__field">
              <textarea class="form__textarea" name="anfrage" placeholder={t('form.inquiry_placeholder')} rows="6" required data-validate data-i18n-placeholder="form.inquiry_placeholder"></textarea>
              <span class="form__error" data-i18n="form.error_inquiry">{t('form.error_inquiry')}</span>
            </div>
          </div>

          <div class="form__row">
            <div class="form__field">
              <label class="form__consent">
                <input type="checkbox" name="einverstanden" required data-validate>
                <span data-i18n-html="form.consent" set:html={t('form.consent')}></span>
              </label>
              <span class="form__error" data-i18n="form.error_consent">{t('form.error_consent')}</span>
            </div>
          </div>

          <!-- Not for people. A robot fills in every field it finds; a person never sees this one. -->
          <div class="form__trap" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
          </div>

          <div class="form__row">
            <button type="submit" class="form__button" data-form-submit disabled data-i18n="form.submit">{t('form.submit')}</button>
          </div>

          <div class="form__failed" data-form-failed hidden data-i18n="form.failed">{t('form.failed')}</div>
          <div class="form__success" data-form-success data-i18n="form.success">{t('form.success')}</div>
        </form>
      </div>
    </div>
  </section>

  <!-- Page-specific scripts -->
  <script src="../scripts/accordion.js"></script>
  <script src="../scripts/ical-client.js"></script>
  <script src="../scripts/calendar.js"></script>
  <script src="../scripts/form.js"></script>
</Base>
