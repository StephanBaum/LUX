---
import Base from '../layouts/Base.astro';
import SEO from '../components/SEO.astro';
import '../styles/components/profile.css';
import {getGermanBundles} from '../lib/content/bundle';
import {createT} from '../lib/content/t';
import {getSiteContent} from '../lib/sanity/queries';
import Photo from '../components/Photo.astro';
import {imageUrl} from '../lib/sanity/image';

const t = createT(await getGermanBundles(), 'index');
const {siteSettings, homePage} = await getSiteContent();
const profile = homePage?.sectionMenschen?.people?.[0] ?? {};
const heroImages = homePage?.heroImages ?? [];
const sliderImages = homePage?.sliderImages ?? [];
const gallery = homePage?.sectionMenschen?.gallery ?? [];

// The four hero photos keep the parallax placement the design uses.
const HERO_PLACEMENT = [
  {speed: '1.2', top: '15%', left: '-5%', width: '38vw', height: '50vh'},
  {speed: '0.6', top: '-10%', right: '10%', width: '35vw', height: '40vh'},
  {speed: '1.5', bottom: '-5%', left: '5%', width: '42vw', height: '35vh'},
  {speed: '0.8', bottom: '-10%', right: '-5%', width: '36vw', height: '55vh'},
];

const GALLERY_SHAPES = ['landscape', 'portrait-sm', 'portrait-md', 'portrait-lg'];

// The photo that follows the cursor over each hero navigation link.
const navImage = (i) => imageUrl(sliderImages[i] ?? heroImages[i], 900);

const organizationSchema = {
  '@type': 'Organization',
  name: siteSettings?.studioName,
  url: 'https://luxenburger.de',
  image: imageUrl(siteSettings?.defaultOgImage, 1200, 630),
  description: siteSettings?.metaDescription ?? t('section_studio.text'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteSettings?.street,
    addressLocality: siteSettings?.city,
    postalCode: siteSettings?.postalCode,
    addressCountry: 'DE'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: siteSettings?.phone,
    contactType: 'customer service',
    email: siteSettings?.email,
    availableLanguage: ['German', 'English']
  },
  sameAs: [siteSettings?.instagram].filter(Boolean)
};
---

<Base
  title="LUX Studio - Professionelles Foto- und Videostudio in Schwalbach"
  description="Studio Luxenburger: Professionelles Foto- und Videostudio in Schwalbach. Studioräume mieten, Equipment-Verleih, Workshops für Fotografie und Film."
>
  <SEO schema={organizationSchema} slot="head" />

  <section class="hero">
    <!-- Floating images with parallax - positions via data attributes -->
    <div class="hero__images">
      {heroImages.map((image, i) => {
        const place = HERO_PLACEMENT[i % HERO_PLACEMENT.length];
        return (
          <div class="hero__image"
               data-speed={place.speed}
               data-top={place.top}
               data-left={place.left}
               data-right={place.right}
               data-bottom={place.bottom}
               data-width={place.width}
               data-height={place.height}>
            <Photo photo={image} width={900} loading="eager" />
          </div>
        );
      })}
    </div>

    <!-- Grid container for content -->
    <div class="hero__content grid">
      <!-- Navigation links - parallax speed calculated by index (first=fastest) -->
      <nav class="hero__nav">
        <a href="/veranstaltungen" class="hero__nav-link" data-img={navImage(0)}>
          <span class="hero__nav-text" data-i18n="nav.veranstaltungen">{t('nav.veranstaltungen')}</span>
          <svg class="hero__nav-arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
          </svg>
        </a>
        <a href="/workshops" class="hero__nav-link" data-img={navImage(1)}>
          <span class="hero__nav-text" data-i18n="nav.workshops">{t('nav.workshops')}</span>
          <svg class="hero__nav-arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
          </svg>
        </a>
        <a href="/studio" class="hero__nav-link" data-img={navImage(2)}>
          <span class="hero__nav-text" data-i18n="nav.studio">{t('nav.studio')}</span>
          <svg class="hero__nav-arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
          </svg>
        </a>
        <a href="/mieten" class="hero__nav-link" data-img={navImage(3)}>
          <span class="hero__nav-text" data-i18n="nav.mieten">{t('nav.mieten')}</span>
          <svg class="hero__nav-arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
          </svg>
        </a>
      </nav>
    </div>

    <!-- Mouse-following image (hidden by default) -->
    <div class="cursor-image">
      <img src="" alt="">
    </div>
  </section>

  <!-- Image Slider -->
  <section class="slider">
    <!-- Custom cursor -->
    <div class="slider__cursor">
      <svg class="slider__cursor-svg" viewBox="0 0 80 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line class="slider__cursor-line" x1="16" y1="12" x2="64" y2="12" stroke="black" stroke-width="1.5"/>
        <path class="slider__cursor-head slider__cursor-head--left" d="M16 12L24 5M16 12L24 19" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
        <path class="slider__cursor-head slider__cursor-head--right" d="M64 12L56 5M64 12L56 19" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="slider__container grid">
      <!-- Drag indicator -->
      <div class="slider__drag-hint">
        <svg class="slider__drag-arrow" viewBox="0 0 40 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 5H38M38 5L33 1M38 5L33 9" stroke="currentColor" stroke-width="1"/>
        </svg>
        <span class="slider__drag-text" data-i18n="slider.hint">{t('slider.hint')}</span>
      </div>
    </div>

    <!-- Track sits at grid edge, extends off-screen -->
    <div class="slider__track-wrapper">
      <div class="slider__track" data-slider-track>
        {sliderImages.map((image) => (
          <div class="slider__slide">
            <Photo photo={image} width={1200} draggable={false} lightbox="home-slider" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full Width Copy Section -->
  <section class="full-width-copy" data-parallax="0.2">
    <div class="full-width-copy__container grid">
      <h2 class="full-width-copy__label" data-animate="fade-up" data-i18n="section_studio.label">{t('section_studio.label')}</h2>
      <p class="full-width-copy__text" data-animate="fade-up" data-i18n="section_studio.text">{t('section_studio.text')}</p>
    </div>
  </section>

  <!-- Profile Section -->
  <section class="profile" data-parallax="0.1">
    <div class="grid">
      <div class="profile__header" data-animate="fade-up">
        <p class="profile__breadcrumb" data-i18n="section_menschen.label">{t('section_menschen.label')}</p>
        <div class="profile__divider"></div>
      </div>

      <div class="profile__content">
        <div class="profile__text" data-animate="fade-up">
          <div class="profile__intro">
            <h2 class="profile__title" data-i18n="section_menschen.title">{t('section_menschen.title')}</h2>
            {profile.email && <a href={`mailto:${profile.email}`} class="profile__email">{profile.email}</a>}
            {(profile.instagram ?? siteSettings?.instagram) && <a href={profile.instagram ?? siteSettings.instagram} class="profile__social" target="_blank" rel="noopener">Instagram</a>}
          </div>

          <p class="profile__bio" data-i18n="section_menschen.bio">{t('section_menschen.bio')}</p>

          <div class="profile__section">
            <h3 class="profile__section-title" data-i18n="section_menschen.education_title">{t('section_menschen.education_title')}</h3>
            <div class="profile__education-item">
              <span class="profile__education-title" data-i18n="section_menschen.expertise1_title">{t('section_menschen.expertise1_title')}</span>
              <span class="profile__education-detail" data-i18n="section_menschen.expertise1_detail">{t('section_menschen.expertise1_detail')}</span>
              <span class="profile__education-year" data-i18n="section_menschen.expertise1_year">{t('section_menschen.expertise1_year')}</span>
            </div>
            <div class="profile__education-item">
              <span class="profile__education-title" data-i18n="section_menschen.expertise2_title">{t('section_menschen.expertise2_title')}</span>
              <span class="profile__education-detail" data-i18n="section_menschen.expertise2_detail">{t('section_menschen.expertise2_detail')}</span>
            </div>
          </div>
        </div>

        <div class="profile__gallery" data-animate="fade-up">
          <div class="profile__gallery-row profile__gallery-row--top">
            {gallery.slice(0, 2).map((image, i) => (
              <div class={`profile__image profile__image--${GALLERY_SHAPES[i]}`}>
                <Photo photo={image} width={800} lightbox="home-profile" />
              </div>
            ))}
          </div>
          <div class="profile__gallery-row profile__gallery-row--bottom">
            {gallery.slice(2, 4).map((image, i) => (
              <div class={`profile__image profile__image--${GALLERY_SHAPES[i + 2]}`}>
                <Photo photo={image} width={800} lightbox="home-profile" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta" data-parallax="0.15">
    <div class="cta__container grid">
      <h2 class="cta__title" data-animate="fade-up" data-i18n="cta.title">{t('cta.title')}</h2>
      <div class="cta__content">
        <p class="cta__text" data-animate="fade-up" data-i18n="cta.text">{t('cta.text')}</p>
        <a href={homePage?.cta?.linkHref ?? `mailto:${siteSettings?.email}`} class="cta__link" data-animate="fade-up">
          <svg class="cta__arrow" viewBox="0 0 55 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 8H53M53 8L46 1M53 8L46 15" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span class="cta__link-text" data-i18n="cta.link">{t('cta.link')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Page-specific scripts -->
  <script src="../scripts/hero.js"></script>
  <script src="../scripts/slider.js"></script>
</Base>
