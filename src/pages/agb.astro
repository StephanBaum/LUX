---
import Base from '../layouts/Base.astro';
import '../styles/components/page-header.css';
import '../styles/components/legal.css';
import '../styles/components/accordion.css';
import {getGermanBundles} from '../lib/content/bundle';

const bundles = await getGermanBundles();
const page = bundles.agb;
const sections = page.sections ?? [];
const updated = page.legal?.updated
  ? new Date(page.legal.updated).toLocaleDateString('de-DE', {month: 'long', year: 'numeric'})
  : '';
---

<Base title={`${page.header?.title} - LUX Studio`}>
  <!-- Page Header -->
  <section class="page-header page-header--legal">
    <div class="page-header__container grid">
      <h1 class="page-header__title" data-animate="fade-up" data-i18n="header.title">{page.header?.title}</h1>
      <div class="page-header__content page-header__content--wide">
        <p class="page-header__text" data-animate="fade-up" data-i18n="header.text">{page.header?.text}</p>
      </div>
    </div>
  </section>

  <!-- Legal Content -->
  <section class="legal legal--agb">
    <div class="legal__container grid">
      {updated && (
        <div class="legal__updated" data-animate="fade-up">
          <span data-i18n="labels.updated">{page.labels?.updated}</span> {updated}
        </div>
      )}

      <div class="accordion accordion--agb" data-accordion data-animate="fade-up">
        {sections.map((section, i) => (
          <div class={`accordion__item${i === 0 ? ' is-open' : ''}`} data-accordion-item>
            <button class="accordion__header" data-accordion-trigger>
              <span class="accordion__title" data-i18n={`sections.${i}.title`}>{section.title}</span>
              <svg class="accordion__arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
              </svg>
            </button>
            <div class="accordion__content" data-accordion-content>
              <div class="accordion__inner">
                <div class="legal__text" data-i18n-html={`sections.${i}.body`} set:html={section.body} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Page-specific scripts -->
  <script src="../scripts/accordion.js"></script>
</Base>
