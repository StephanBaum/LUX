---
import Base from '../layouts/Base.astro';
import '../styles/components/page-header.css';
import '../styles/components/accordion.css';
import {getGermanBundles} from '../lib/content/bundle';
import {createT} from '../lib/content/t';
import {getSiteContent} from '../lib/sanity/queries';
import Photo from '../components/Photo.astro';
import {imageUrl} from '../lib/sanity/image';

const t = createT(await getGermanBundles(), 'veranstaltungen');
const {siteSettings, veranstaltungenPage, events} = await getSiteContent();
const sliderImages = veranstaltungenPage?.sliderImages ?? [];

const dateLabel = (value) =>
  value ? new Date(value).toLocaleDateString('de-DE', {day: '2-digit', month: '2-digit', year: 'numeric'}) : '';

const items = (events ?? []).map((event, i) => ({
  ...event,
  key: event.slug?.current ?? event._id,
  label: dateLabel(event.startAt),
  image: imageUrl(event.photo, 1400),
}));
---

<Base title="Veranstaltungen - LUX Studio">
  <!-- Page Header with Image -->
  <section class="page-header page-header--with-image">
    <div class="page-header__container grid">
      <h1 class="page-header__title" data-animate="fade-up" data-i18n="header.title">{t('header.title')}</h1>
      <div class="page-header__image" data-animate="fade-up">
        <Photo photo={sliderImages[5] ?? sliderImages[0]} width={1400} />
      </div>
      <div class="page-header__content">
        <p class="page-header__text" data-animate="fade-up" data-i18n="header.text">{t('header.text')}</p>
      </div>
    </div>
  </section>

  <!-- Image Slider -->
  <section class="slider">
    <div class="slider__cursor">
      <svg class="slider__cursor-svg" viewBox="0 0 80 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line class="slider__cursor-line" x1="16" y1="12" x2="64" y2="12" stroke="black" stroke-width="1.5"/>
        <path class="slider__cursor-head slider__cursor-head--left" d="M16 12L24 5M16 12L24 19" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
        <path class="slider__cursor-head slider__cursor-head--right" d="M64 12L56 5M64 12L56 19" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="slider__container grid">
      <div class="slider__drag-hint">
        <svg class="slider__drag-arrow" viewBox="0 0 40 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 5H38M38 5L33 1M38 5L33 9" stroke="currentColor" stroke-width="1"/>
        </svg>
        <span class="slider__drag-text" data-i18n="header.title">{t('header.title')}</span>
      </div>
    </div>
    <div class="slider__track-wrapper">
      <div class="slider__track" data-slider-track>
        {sliderImages.map((image) => (
          <div class="slider__slide">
            <Photo photo={image} width={1200} draggable={false} lightbox="events-slider" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Events Accordions -->
  <section class="subpage-section">
    <div class="grid">
      <div class="subpage-section__content" data-animate="fade-up">
        <div class="accordion" data-accordion data-accordion-images>
          {items.map((item, i) => (
            <div class={`accordion__item${i === 0 ? ' is-open' : ''}`} data-accordion-item data-image={item.image}>
              <button class="accordion__header" data-accordion-trigger>
                <span class="accordion__label">{item.label}</span>
                <span class="accordion__title" data-i18n={`events.${item.key}.title`}>{item.title}</span>
                <svg class="accordion__arrow" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 0V27H24V6.37305L3.17383 27.1016L0.351562 24.2666L20.7139 4H0V0H28Z" fill="currentColor"/>
                </svg>
              </button>
              <div class="accordion__content" data-accordion-content>
                <div class="accordion__inner">
                  <div class="accordion__text">
                    <div class="accordion__profile-intro">
                      <h3 class="accordion__profile-title" data-i18n="events.details_title">{t('events.details_title')}</h3>
                      {siteSettings?.email && (
                        <a href={`mailto:${siteSettings.email}`} class="accordion__profile-email">{siteSettings.email}</a>
                      )}
                    </div>
                    <div class="accordion__profile-section">
                      <h4 class="accordion__profile-section-title" data-i18n="events.registration_label">{t('events.registration_label')}</h4>
                      {(item.infos ?? []).map((info, n) => (
                        <div class="accordion__profile-item">
                          <span class="accordion__profile-item-title" data-i18n={`events.${item.key}.infos.${n}.label`}>{info.label}</span>
                          <span class="accordion__profile-item-detail" data-i18n={`events.${item.key}.infos.${n}.value`}>{info.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                  <div class="accordion__description">
                    <p data-i18n={`events.${item.key}.desc`}>{item.description}</p>
                  </div>
                </div>
              </div>
            </div>
          ))}
          {items.length === 0 && <p class="accordion__empty" data-i18n="events.empty">{t('events.empty')}</p>}
        </div>
      </div>
      <!-- Image container - LEFT side for right-aligned accordion -->
      <div class="subpage-section__image subpage-section__image--left is-visible" data-accordion-image-target>
        <Photo photo={items[0]?.photo} width={1400} />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta" data-parallax="0.15">
    <div class="cta__container grid">
      <h2 class="cta__title" data-i18n="cta.title" data-animate="fade-up">{t('cta.title')}</h2>
      <div class="cta__content">
        <p class="cta__text" data-i18n="cta.text" data-animate="fade-up">{t('cta.text')}</p>
        <a href={veranstaltungenPage?.cta?.linkHref ?? `mailto:${siteSettings?.email}`} class="cta__link" data-animate="fade-up">
          <svg class="cta__arrow" viewBox="0 0 55 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 8H53M53 8L46 1M53 8L46 15" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span class="cta__link-text" data-i18n="cta.link">{t('cta.link')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Page-specific scripts -->
  <script src="../scripts/slider.js"></script>
  <script src="../scripts/accordion.js"></script>
</Base>
